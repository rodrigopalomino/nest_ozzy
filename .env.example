# ===================================================================================
# nest_ozzy — plantilla de variables de entorno
#
# Copiar a .env y rellenar. El .env real no se versiona.
#   cp .env.example .env
#
# Generar los secretos:
#   JWT_SECRET      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ADMIN_PASSWORD  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# ===================================================================================

NODE_ENV=development
PORT=3001

# ===================================================================================
# Base de datos
# ===================================================================================
# mysql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=

# ===================================================================================
# OBLIGATORIAS — la API no arranca si falta cualquiera de estas
# ===================================================================================

# Mínimo 32 caracteres aleatorios. No reutilizar entre entornos.
JWT_SECRET=

# Client ID "Aplicación web" de Google Cloud Console, termina en
# .apps.googleusercontent.com. El mismo que use el front next_ozzy.
GOOGLE_CLIENT_ID=

# MinIO: las tres son obligatorias.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# ===================================================================================
# MinIO — resto (tienen valores por defecto)
# ===================================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# URL pública de lectura (dominio o CDN en producción).
MINIO_PUBLIC_URL=

# ===================================================================================
# CORS
# ===================================================================================
# Orígenes del front separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:3000

# ===================================================================================
# Seed del administrador (sólo `npm run seed`)
# ===================================================================================
ADMIN_USERNAME=admin
# Mínimo 10 caracteres. Sin esto el seed no crea el usuario.
ADMIN_PASSWORD=

# ===================================================================================
# OPCIONALES
# ===================================================================================
# Sin SMTP los correos se registran en el log sin enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# /docs abierto en producción sólo si es "true".
SWAGGER_ENABLED=false
